# ArchonAI Application Environment Configuration

APP_NAME="ArchonAI"
APP_ENV="development"
APP_DEBUG=true
APP_URL="http://localhost/archonai"

# Database Configuration (XAMPP MySQL / MariaDB Default)
DB_CONNECTION="mysql"
DB_HOST="127.0.0.1"
DB_PORT=3306
DB_DATABASE="archonai"
DB_USERNAME="root"
DB_PASSWORD=""
DB_CHARSET="utf8mb4"

# GitHub REST API Configuration (Optional: token increases rate limit from 60 to 5000 requests/hour)
GITHUB_API_TOKEN=""

# AI Inference Service (Ollama HTTP API)
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="codellama"
OLLAMA_TIMEOUT=60

# Session Configuration
SESSION_LIFETIME=7200
SESSION_SECURE_COOKIE=false
